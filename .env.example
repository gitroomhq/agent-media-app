# agent-media — environment template (self-host)
# Copy to .env and fill in. All config is injected at RUNTIME — never commit .env.
# Names below match what the code actually reads (verified against source).

# ── Supabase (identity + data) — required ────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # server-side only; bypasses RLS — treat as root
SUPABASE_ANON_KEY=                # JWT verification + OAuth proxy; absent = OAuth off
NEXT_PUBLIC_SUPABASE_URL=         # web (browser-safe)
NEXT_PUBLIC_SUPABASE_ANON_KEY=    # web (browser-safe)

# ── Providers ─────────────────────────────────────────────────────────────
EVOLINK_API_KEYS=                 # comma-separated pool (video: Seedance 2.0 mini)
EVOLINK_MAX_CONCURRENT_PER_KEY=3
OPENAI_API_KEY=                   # gpt-image-2 + image moderation (absent = moderation off)
ANTHROPIC_API_KEY=                # prompt craft (Haiku/Opus)

# ── Cloudflare R2 (object storage) — required by workers ─────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=agent-media-outputs     # NOTE: code reads R2_BUCKET (not R2_BUCKET_NAME)
R2_PUBLIC_URL=

# ── Temporal (vNext orchestration) — required for composed workflows ─────
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
TEMPORAL_TLS=true

# ── Stripe (billing) — OPTIONAL: leave empty to run with billing OFF ─────
# Self-hosters generate freely against their own provider keys; no Stripe needed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Internal service auth (generate long random strings) ─────────────────
WORKER_SECRET=
INTERNAL_API_SECRET=
CRON_SECRET=
SUBTITLE_WORKER_SECRET=
VNEXT_PRIMITIVE_WORKER_SECRET=

# ── Feature flags ─────────────────────────────────────────────────────────
VNEXT_PRIMITIVES_ENABLED=true     # off = the vNext skills surface is dark
MAKE_UGC_ENABLED=true             # curates the agent surface to make_ugc (+podcast/subtitles)
IMAGE_MODERATION_FAILCLOSED=      # set 1 to fail closed on moderation outages

# ── URLs ──────────────────────────────────────────────────────────────────
PUBLIC_API_ORIGIN=http://localhost:3001
PORT=3001

# ── Web app (read at RUNTIME by the root layout, not baked at build) ─────
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_MCP_URL=http://localhost:3001/mcp
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# ── Provider selection (see services/media-worker-v2/src/providers/) ─────
# Registered adapters: evolink (default), byteplus
VIDEO_PROVIDER=evolink
# Optional model pins
EVOLINK_SEEDANCE_MODEL=
BYTEPLUS_SEEDANCE_MODEL=
GPT_IMAGE_MODEL=
# Required only when VIDEO_PROVIDER=byteplus
ARK_API_KEY=

# ── Access control & support (fail-closed defaults) ──────────────────────
# Comma-separated admin emails. EMPTY by default: a fresh install grants
# admin to nobody until you opt someone in.
ADMIN_EMAILS=
NEXT_PUBLIC_ADMIN_EMAILS=
# Support form: empty disables it.
SUPPORT_INBOX=
SUPPORT_FROM=
RESEND_API_KEY=

# ── Optional browser-facing config ───────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_DISCORD_INVITE_URL=
