# agent-media — environment template (self-host)
# Copy to .env and fill in. All config is injected at RUNTIME — never commit .env.
# Names below match what the code actually reads (verified against source).
#
# NOTE: never put a comment after `=` on the same line. Docker Compose's
# `env_file` reader does not strip them, so `FOO=bar   # note` sets FOO to the
# literal string "bar   # note". Comments live on their own line, above the var.

# ── Supabase (identity + data) — required ────────────────────────────────
SUPABASE_URL=
# server-side only; bypasses RLS — treat as root
SUPABASE_SERVICE_ROLE_KEY=
# JWT verification + OAuth proxy; absent = OAuth off
SUPABASE_ANON_KEY=
# browser-safe copies read at runtime by the web app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Providers ─────────────────────────────────────────────────────────────
# comma-separated pool (video: Seedance 2.0 mini)
EVOLINK_API_KEYS=
EVOLINK_MAX_CONCURRENT_PER_KEY=3
# gpt-image-2 + image moderation (absent = moderation off)
OPENAI_API_KEY=
# prompt craft (Haiku/Opus)
ANTHROPIC_API_KEY=

# ── Object storage (S3-compatible) — required by workers ─────────────────
# Defaults target Cloudflare R2. Set S3_ENDPOINT to point anywhere else
# (MinIO, AWS S3, Backblaze B2) — docker-compose.yml does exactly that.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# NOTE: code reads R2_BUCKET (not R2_BUCKET_NAME)
R2_BUCKET=agent-media-outputs
R2_PUBLIC_URL=
# Empty = derive https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# MinIO example: S3_ENDPOINT=http://minio:9000 with S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=
# Empty = "auto" (correct for R2). AWS S3 needs a real region, e.g. us-east-1
S3_REGION=
# "true" for MinIO and most non-AWS gateways; empty = virtual-hosted style
S3_FORCE_PATH_STYLE=

# ── Temporal (vNext orchestration) — required for composed workflows ─────
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
TEMPORAL_TLS=true

# ── Billing mode ─────────────────────────────────────────────────────────
# FAIL-CLOSED: billing is ON unless you explicitly set BILLING_MODE=disabled.
# Self-hosters set `disabled` to skip the credit ledger entirely and pay their
# upstream providers directly.
#
# ⚠ Set this IDENTICALLY on api-v2 AND every worker. A split configuration is
# how media gets rendered without being charged.
BILLING_MODE=

# Stripe — only needed when BILLING_MODE is not 'disabled'.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Internal service auth (generate long random strings) ─────────────────
WORKER_SECRET=
INTERNAL_API_SECRET=
CRON_SECRET=
SUBTITLE_WORKER_SECRET=
VNEXT_PRIMITIVE_WORKER_SECRET=

# ── Feature flags ─────────────────────────────────────────────────────────
# off = the vNext skills surface is dark
VNEXT_PRIMITIVES_ENABLED=true
# curates the agent surface to make_ugc (+ podcast/subtitles)
MAKE_UGC_ENABLED=true
# set 1 to fail closed on moderation outages
IMAGE_MODERATION_FAILCLOSED=

# ── URLs ──────────────────────────────────────────────────────────────────
PUBLIC_API_ORIGIN=http://localhost:3001
PORT=3001

# ── Web app (read at RUNTIME by the root layout, not baked at build) ─────
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_MCP_URL=http://localhost:3001/mcp
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# ── Provider selection (see services/media-worker-v2/src/providers/) ─────
# Registered adapters: evolink (default), byteplus
VIDEO_PROVIDER=evolink
# Optional model pins
EVOLINK_SEEDANCE_MODEL=
BYTEPLUS_SEEDANCE_MODEL=
GPT_IMAGE_MODEL=
# Required only when VIDEO_PROVIDER=byteplus
ARK_API_KEY=

# ── Access control & support (fail-closed defaults) ──────────────────────
# Comma-separated admin emails. EMPTY by default: a fresh install grants
# admin to nobody until you opt someone in.
ADMIN_EMAILS=
NEXT_PUBLIC_ADMIN_EMAILS=
# Support form: empty disables it.
SUPPORT_INBOX=
SUPPORT_FROM=
RESEND_API_KEY=

# ── Optional browser-facing config ───────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_DISCORD_INVITE_URL=
