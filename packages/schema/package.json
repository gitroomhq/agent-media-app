{
  "name": "@agentmedia/schema",
  "version": "0.5.5",
  "description": "Type-safe schema definitions for AI UGC video generation \u2014 enums, Zod validation, and generator registry. Single source of truth for the agent-media platform.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://agent-media.ai/docs/api-reference",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitroomhq/agent-media-app.git",
    "directory": "packages/schema"
  },
  "keywords": [
    "ugc",
    "video-generation",
    "ai",
    "schema",
    "zod",
    "validation",
    "typescript",
    "sdk",
    "developer-tools",
    "text-to-video",
    "talking-head",
    "product-video",
    "product-ugc",
    "openapi",
    "mcp",
    "agent-media"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2/index.d.ts",
      "import": "./dist/v2/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:edge-schema": "tsx scripts/generate-edge-schema.ts",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "gen:v2-docs": "tsx scripts/generate-v2-docs.ts",
    "gen:v1-tool-contracts": "tsx scripts/generate-v1-tool-contracts.ts",
    "check:spec": "tsx scripts/check-spec-freshness.ts",
    "check:sdk-types": "npx openapi-typescript ../../generated/openapi.json -o ../../generated/api-types.d.ts && echo '\u2713 SDK types generated'"
  },
  "dependencies": {
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "vitest": "^3.1.0"
  }
}
